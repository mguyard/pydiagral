# Settings for try_pydiagral.py. Copy this file to `.env`, next to the script,
# and fill it in. `.env` is git-ignored: never commit or share it.

# Required: the e-mail address and password of your Diagral account.
DIAGRAL_USERNAME=your_email@example.com
DIAGRAL_PASSWORD=your_password

# The serial ID of your box. Every scenario but `ping` and `systems` needs it;
# run `uv run try_pydiagral.py systems` to list the ones of your account.
DIAGRAL_SERIAL_ID=

# Your alarm PIN code (also named master code), needed by `status`, `details`
# and every scenario that arms or disarms.
DIAGRAL_PIN_CODE=

# An existing API key. Left empty, the script creates a temporary one and
# deletes it at the end; `--keep-apikey` keeps it and prints the two values
# to paste here.
DIAGRAL_API_KEY=
DIAGRAL_SECRET_KEY=

# The brand of your account: DIAGRAL (default), DAITEM, EDAITEM, LOGISTYALMA
# or DISTRIBUTION.
DIAGRAL_VENDOR=
